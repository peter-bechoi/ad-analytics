# ── 백엔드 (Railway) ──────────────────────────────────────────
# 프론트엔드 Vercel 배포 URL (쉼표 구분으로 여러 개 가능)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Railway가 자동으로 주입 (직접 설정 불필요)
# PORT=8000

# ── 프론트엔드 (Vercel) ───────────────────────────────────────
# 현재 vercel.json rewrites 방식 사용 중이므로 별도 설정 불필요
# vercel.json의 destination 값을 Railway URL로 교체하세요
